{
	"name": "de-swebhosting/typo3-extension-buildtools",
	"description": "Contains scripts to test and release TYPO3 Extensions",
	"license": "GPL-3.0-or-later",
	"type": "composer-plugin",
	"require": {
		"php": "^8.2",
		"composer-plugin-api": "^2.0",
		"bnf/phpstan-psr-container": "^1.1.0",
		"codeception/codeception": "^5.3.5",
		"codeception/module-asserts": "^3.3.0",
		"codeception/module-webdriver": "^4.0.5",
		"de-swebhosting/php-codestyle": "^7.0.0",
		"ergebnis/composer-normalize": "^2.42",
		"friendsofphp/php-cs-fixer": "^3.95",
		"michielroos/typo3scan": "^1.7",
		"phpstan/phpstan": "^2.1.50",
		"phpstan/phpstan-phpunit": "^2.0.16",
		"squizlabs/php_codesniffer": "^3.9",
		"symfony/dom-crawler": "^6.3",
		"typo3/cms-backend": "^14.0",
		"typo3/cms-core": "^14.0",
		"typo3/cms-extbase": "^14.0",
		"typo3/cms-filelist": "^14.0",
		"typo3/cms-fluid": "^14.0",
		"typo3/cms-frontend": "^14.0",
		"typo3/cms-install": "^14.0",
		"typo3/testing-framework": "^9.5"
	},
	"require-dev": {
		"composer/composer": "^2.9.7",
		"phpunit/phpunit": "^11.2.5"
	},
	"autoload": {
		"psr-4": {
			"De\\SWebhosting\\Buildtools\\": "src/",
			"TYPO3\\JsonResponse\\": "../../typo3/testing-framework/Resources/Core/Functional/Extensions/json_response/Classes"
		}
	},
	"bin": [
		"bin/t3_build_ext_emconf.php",
		"bin/t3_check_codestyle.sh",
		"bin/t3_cleanup_for_ter.sh",
		"bin/t3_deploy_to_ter.sh",
		"bin/t3_get_tag_comment.sh",
		"bin/t3_get_tag_version.sh",
		"bin/t3_prepare_release.sh",
		"bin/t3_run_tests.sh"
	],
	"config": {
		"allow-plugins": {
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		}
	},
	"extra": {
		"class": "De\\SWebhosting\\Buildtools\\Plugin"
	},
	"scripts": {
		"check": [
			"@check:php:cgl",
			"@check:composer",
			"@check:prettier"
		],
		"check:composer": [
			"@composer validate",
			"@composer normalize --dry-run --diff"
		],
		"check:php:cgl": [
			"@putenv XDEBUG_MODE=off",
			"php-cs-fixer fix --dry-run --diff --config=build/php-cs-fixer/config.php"
		],
		"check:prettier": "npx prettier --check .",
		"ci": [
			"@check"
		],
		"fix": [
			"@fix:php:cgl",
			"@fix:prettier"
		],
		"fix:php:cgl": [
			"@putenv XDEBUG_MODE=off",
			"php-cs-fixer fix --config=build/php-cs-fixer/config.php"
		],
		"fix:prettier": "npx prettier --write ."
	},
	"scripts-descriptions": {
		"check": "Runs check:php:cgl, check:composer and check:prettier.",
		"check:composer": "Validates and checks normalization of composer.json.",
		"check:php:cgl": "Checks PHP coding guidelines using PHP-CS-Fixer.",
		"check:prettier": "Checks formatting using Prettier.",
		"ci": "Runs all checks identical to the self-lint pipeline.",
		"fix": "Runs fix:php:cgl and fix:prettier.",
		"fix:php:cgl": "Fixes PHP coding guidelines using PHP-CS-Fixer.",
		"fix:prettier": "Fixes formatting using Prettier."
	}
}

{
	"name": "my-namespace/my-ext",
	"description": "Example composer.json for a TYPO3 extension using de-swebhosting/typo3-extension-buildtools",
	"license": "GPL-3.0-or-later",
	"type": "typo3-cms-extension",
	"require": {
		"php": "^8.2",
		"typo3/cms-core": "~13.4.0"
	},
	"require-dev": {
		"de-swebhosting/typo3-extension-buildtools": "dev-TYPO3_14"
	},
	"autoload": {
		"psr-4": {
			"Vendor\\MyExt\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Vendor\\MyExt\\Tests\\": "Tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"de-swebhosting/typo3-extension-buildtools": true,
			"ergebnis/composer-normalize": true,
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"bin-dir": "bin",
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/class-alias-loader": {
			"always-add-alias-loader": true
		},
		"typo3/cms": {
			"extension-key": "my_ext",
			"web-dir": ".Build/Web"
		},
		"typo3-extension-buildtools": {
			"phpcs-ruleset": "MyCodingStandard",
			"typo3scan-ignore": ["1234567890", "1234567891"]
		}
	},
	"scripts": {
		"post-autoload-dump": [
			"De\\SWebhosting\\Buildtools\\ExtensionTestEnvironment::prepare"
		]
	}
}
